---
// 辉光管数字显示器 —— 致敬《命运石之门》的世界线变动率探测仪。
// 加载时数字乱跳后定格在 1.048596；点击会“跳跃”到另一条世界线。
interface Props {
  label?: string;
}
const { label = 'World line' } = Astro.props;
const initial = '1.048596';
---

<button class="nixie" type="button" data-nixie aria-label={`${label} ${initial}`}>
  <span class="nixie__label mono">{label}</span>
  <span class="nixie__tubes" aria-hidden="true">
    {[...initial].map((ch) =>
      ch === '.' ? (
        <span class="tube tube--dot"><span class="dot"></span></span>
      ) : (
        <span class="tube"><span class="digit" data-digit>{ch}</span></span>
      ),
    )}
  </span>
</button>

<style>
  .nixie {
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .nixie__label { font-size: 10px; color: var(--ink-muted); letter-spacing: 0.16em; }
  .nixie__tubes {
    display: inline-flex;
    gap: 4px;
    padding: 6px;
    background: linear-gradient(#1a1410, #0e0b09);
    border: 1px solid rgba(255, 138, 61, 0.18);
    border-radius: 6px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  .tube {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 46px;
    border-radius: 14px 14px 6px 6px;
    background:
      repeating-linear-gradient(90deg, rgba(255, 140, 60, 0.07) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(0deg, rgba(255, 140, 60, 0.05) 0 1px, transparent 1px 4px),
      radial-gradient(ellipse at 50% 40%, rgba(255, 120, 40, 0.16), rgba(20, 14, 10, 0.95) 70%);
    border: 1px solid rgba(255, 180, 120, 0.12);
    overflow: hidden;
  }
  .tube::after {
    /* 玻璃高光 */
    content: '';
    position: absolute;
    inset: 3px auto auto 5px;
    width: 6px;
    height: 60%;
    border-radius: 6px;
    background: linear-gradient(rgba(255, 255, 255, 0.12), transparent);
  }
  .tube--dot { width: 12px; }
  .digit {
    font-family: var(--font-mono);
    font-size: 30px;
    line-height: 1;
    font-weight: 400;
    color: #ffb36b;
    text-shadow: 0 0 4px #ff7a1f, 0 0 10px #ff5a00, 0 0 22px rgba(255, 90, 0, 0.6);
    transition: opacity 0.05s;
  }
  .digit.is-flicker { opacity: 0.55; }
  .dot {
    align-self: end;
    margin-bottom: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffb36b;
    box-shadow: 0 0 4px #ff7a1f, 0 0 10px #ff5a00;
  }
  .nixie:hover .nixie__tubes { border-color: rgba(255, 138, 61, 0.4); }
  @media (max-width: 420px) {
    .tube { width: 24px; height: 38px; }
    .tube--dot { width: 10px; }
    .digit { font-size: 24px; }
  }
</style>

<script>
  // 剧中出现过的几条世界线，点击依次跳转
  const WORLD_LINES = ['1.048596', '0.571024', '0.523299', '1.130205', '0.337187'];

  document.querySelectorAll<HTMLButtonElement>('[data-nixie]').forEach((el) => {
    const digits = [...el.querySelectorAll<HTMLElement>('[data-digit]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const label = el.getAttribute('aria-label')!.split(' ').slice(0, -1).join(' ');
    let idx = 0;
    let busy = false;

    const show = (value: string) => {
      const target = value.replace('.', '');
      el.setAttribute('aria-label', `${label} ${value}`);
      if (reduce) {
        digits.forEach((d, i) => (d.textContent = target[i]));
        return;
      }
      busy = true;
      let done = 0;
      digits.forEach((d, i) => {
        const stopAt = performance.now() + 500 + i * 160;
        const tick = () => {
          if (performance.now() < stopAt) {
            d.textContent = String(Math.floor(Math.random() * 10));
            d.classList.toggle('is-flicker', Math.random() < 0.3);
            setTimeout(tick, 45);
          } else {
            d.textContent = target[i];
            d.classList.remove('is-flicker');
            if (++done === digits.length) busy = false;
          }
        };
        tick();
      });
    };

    // 进入视口时播放一次开机动画
    new IntersectionObserver(([e], io) => {
      if (e.isIntersecting) {
        show(WORLD_LINES[0]);
        io.disconnect();
      }
    }).observe(el);

    el.addEventListener('click', () => {
      if (busy) return;
      idx = (idx + 1) % WORLD_LINES.length;
      show(WORLD_LINES[idx]);
    });
  });
</script>
