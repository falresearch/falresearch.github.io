---
import { type Lang, loc, localizePath, useT } from '../i18n';
import { site } from '../data/site';
import Logo from './Logo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const links = [
  { href: '/', label: t('nav.home') },
  { href: '/research', label: t('nav.research') },
  { href: '/publications', label: t('nav.publications') },
  { href: '/people', label: t('nav.people') },
  { href: '/contact', label: t('nav.contact') },
];
const year = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="container">
    <div class="footer__big" aria-hidden="true">{site.shortName}<span>.</span></div>

    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo"><Logo size={44} /><strong>{loc(site.name, lang)}</strong></div>
        <p>{loc(site.affiliation, lang)}</p>
      </div>
      <div>
        <h3 class="mono footer__h">{t('footer.quick')}</h3>
        <ul class="footer__list">
          {links.map((l) => <li><a href={localizePath(lang, l.href)}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="mono footer__h">{t('join.contact')}</h3>
        <ul class="footer__list">
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="mono footer__h">Links</h3>
        <ul class="footer__list">
          {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer__bottom mono">
      <span>© {year} {loc(site.name, lang)} · {t('footer.rights')} · {t('footer.analytics')}</span>
      <a href="#main">↑ Top</a>
    </div>
  </div>
</footer>

<style>
  .footer { padding-top: clamp(56px, 8vw, 96px); overflow: hidden; border-top: 1px solid var(--ink-line); }
  .footer__big {
    font-family: var(--font-mono);
    font-size: clamp(64px, 17vw, 240px);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.18);
    margin-bottom: clamp(40px, 6vw, 72px);
    user-select: none;
  }
  .footer__big span { color: var(--accent); -webkit-text-stroke: 0; }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr 0.8fr;
    gap: 40px;
    padding-bottom: 48px;
  }
  .footer__logo { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; font-size: 17px; }
  .footer__brand p { color: var(--ink-muted); font-size: 14px; max-width: 34ch; }
  .footer__h { color: var(--ink-muted); font-weight: 400; margin-bottom: 16px; }
  .footer__list { display: grid; gap: 10px; font-size: 14px; color: var(--ink-text); }
  .footer__list a:hover { color: var(--accent); }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px;
    border-top: 1px solid var(--ink-line);
    color: var(--ink-muted);
    font-size: 11px;
  }
  .footer__bottom a:hover { color: var(--accent); }
  @media (max-width: 900px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer__grid { grid-template-columns: 1fr; gap: 32px; }
    .footer__bottom { flex-direction: column; }
  }
</style>
