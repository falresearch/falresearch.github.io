---
// 子页面顶部的深色标题区
interface Props {
  index: string;
  label: string;
  title: string;
  lead?: string;
}
const { index, label, title, lead } = Astro.props;
---

<section class="phero dark grid-bg">
  <div class="container phero__inner">
    <div class="phero__meta mono">
      <span>[{index}]</span>
      <span class="phero__bar"></span>
      <span>{label}</span>
    </div>
    <h1 class="display phero__title">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    border-bottom: 1px solid var(--ink-line);
    overflow: hidden;
  }
  .phero::after {
    content: '';
    position: absolute;
    inset: auto -10% -60% auto;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(200, 240, 49, 0.12), transparent 60%);
    pointer-events: none;
  }
  .phero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(64px, 10vw, 128px) clamp(48px, 7vw, 88px);
  }
  .phero__meta { display: flex; align-items: center; gap: 14px; color: var(--ink-muted); margin-bottom: 28px; }
  .phero__bar { width: 48px; height: 1px; background: var(--accent); }
  .phero__title { max-width: 16ch; margin-bottom: 24px; }
</style>
