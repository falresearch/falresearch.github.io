---
// 首屏动画的“监视器”外框：网格底纹、四角荧光标记和四个角落的等宽小标注
interface Props {
  tl?: string;
  tr?: string;
  bl?: string;
  br?: string;
}
const { tl = '', tr = '', bl = '', br = '● LIVE' } = Astro.props;
---

<div class="hframe" data-hframe>
  <slot />
  {tl && <div class="hframe__corner tl mono" set:html={tl} />}
  {tr && <div class="hframe__corner tr mono" set:html={tr} />}
  {bl && <div class="hframe__corner bl mono" set:html={bl} />}
  {br && <div class="hframe__corner br mono" set:html={br} />}
  <span class="hframe__tick t1"></span><span class="hframe__tick t2"></span>
  <span class="hframe__tick t3"></span><span class="hframe__tick t4"></span>
</div>

<style>
  .hframe {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    border: 1px solid var(--ink-line);
    background:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 24px 24px,
      radial-gradient(circle at 50% 40%, rgba(200, 240, 49, 0.08), transparent 62%),
      var(--ink-2);
    overflow: hidden;
  }
  .hframe :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hframe__corner { position: absolute; z-index: 2; font-size: 10px; color: var(--ink-muted); pointer-events: none; }
  .hframe__corner :global(b) { font-weight: 500; color: var(--ink-text); font-size: 12px; }
  .tl { top: 12px; left: 14px; }
  .tr { top: 12px; right: 14px; text-align: right; }
  .bl { bottom: 12px; left: 14px; }
  .br { bottom: 12px; right: 14px; color: var(--accent); }
  .hframe__tick { position: absolute; z-index: 2; width: 14px; height: 14px; border-color: var(--accent); border-style: solid; }
  .t1 { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
  .t2 { top: -1px; right: -1px; border-width: 2px 2px 0 0; }
  .t3 { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; }
  .t4 { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }
</style>
