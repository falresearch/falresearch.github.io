---
// 首屏总览动画用的线稿小图标（64×64 画布，可放到任意位置与大小）
// kind：ehr 电子病历 / text 临床文本 / ask 真实提问 / chip 大模型 / chart 诊断预测 /
//       patient 虚拟患者 / qa 健康问答 / scale 可信评估
interface Props {
  kind: 'ehr' | 'text' | 'ask' | 'chip' | 'chart' | 'patient' | 'qa' | 'scale';
  x: number;
  y: number;
  size?: number;
  delay?: number;
}
const { kind, x, y, size = 64, delay = 0 } = Astro.props;
const d = (s = 0) => `--d:${(delay + s).toFixed(2)}s`;
---

<svg x={x} y={y} width={size} height={size} viewBox="0 0 64 64" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {kind === 'ehr' && (
    <g>
      <rect x="12" y="6" width="40" height="52" rx="4" pathLength="1" class="ha-draw" style={d()} />
      <path d="M12 16 H52" stroke-opacity="0.45" pathLength="1" class="ha-draw" style={d(0.3)} />
      <path d="M17 11 h6 M20 8 v6" class="ha-acc ha-pop" stroke-width="2" style={d(0.4)} />
      {[24, 30, 36].map((yy, i) => <path d={`M18 ${yy} H${i === 1 ? 38 : 46}`} stroke-opacity="0.5" pathLength="1" class="ha-draw" style={d(0.5 + i * 0.1)} />)}
      <rect x="18" y="42" width="6" height="6" rx="1.5" stroke-opacity="0.6" class="ha-fade" style={d(0.8)} />
      <path d="M19 45 l2 2 l3 -4" class="ha-acc ha-draw" pathLength="1" style={d(1)} />
      <path d="M28 45 H46" stroke-opacity="0.5" class="ha-fade" style={d(0.8)} />
    </g>
  )}
  {kind === 'text' && (
    <g>
      {[14, 24, 34, 44].map((yy, i) => <path d={`M8 ${yy} H${[56, 48, 54, 40][i]}`} stroke-opacity="0.45" pathLength="1" class="ha-draw" style={d(i * 0.12)} />)}
      <rect x="20" y="19" width="18" height="10" rx="2" class="ha-soft ha-fade" style={d(0.7)} />
      <rect x="20" y="19" width="18" height="10" rx="2" class="ha-acc ha-fade" style={d(0.7)} />
      <rect x="30" y="39" width="14" height="10" rx="2" stroke="#78c8ff" class="ha-fade" style={d(0.9)} />
    </g>
  )}
  {kind === 'ask' && (
    <g>
      {[[6, 10, 40], [18, 26, 38], [8, 42, 44]].map(([xx, yy, w], i) => (
        <g class="ha-pop" style={d(i * 0.15)}>
          <rect x={xx} y={yy} width={w} height="12" rx="6" stroke-opacity={0.5 + i * 0.2} />
          <path d={`M${xx + 7} ${yy + 6} H${xx + w - 12}`} stroke-dasharray="2 3" stroke-opacity="0.5" />
        </g>
      ))}
      <text x="52" y="50" class="ha-cap ha-fade" style={`${d(0.6)};font-size:14px`}>?</text>
    </g>
  )}
  {kind === 'chip' && (
    <g>
      <rect x="10" y="10" width="44" height="44" rx="7" pathLength="1" class="ha-draw" style={d()} />
      {[20, 32, 44].map((p) => <path d={`M${p} 4 V10 M${p} 54 V60 M4 ${p} H10 M54 ${p} H60`} stroke-opacity="0.5" class="ha-fade" style={d(0.4)} />)}
      {[0, 1, 2].map((r) => [0, 1, 2].map((c) => (
        <rect x={18 + c * 10} y={18 + r * 10} width="7" height="7" rx="1.5" class:list={[r === 1 && c === 1 ? 'ha-acc-fill ha-pulse' : 'ha-pop']} stroke-opacity="0.6" style={d(0.5 + (r * 3 + c) * 0.04)} />
      )))}
    </g>
  )}
  {kind === 'chart' && (
    <g>
      <path d="M8 8 V54 H58" stroke-opacity="0.5" pathLength="1" class="ha-draw" style={d()} />
      <path d="M38 10 V54" stroke-dasharray="2 3" stroke-opacity="0.4" class="ha-fade" style={d(0.4)} />
      <path d="M38 34 L48 24 L56 14 L56 32 L48 36 Z" class="ha-soft ha-fade" style={d(1)} />
      <polyline points="10,46 18,42 26,44 32,36 38,34" pathLength="1" class="ha-draw" style={d(0.4)} />
      <polyline points="38,34 48,28 56,22" class="ha-acc ha-flow" stroke-dasharray="3 3" stroke-width="2" style={d(1)} />
      <circle cx="56" cy="22" r="3" class="ha-acc-fill ha-pop" style={d(1.3)} />
      <circle cx="56" cy="22" r="6" class="ha-acc ha-pulse" style={d(1.4)} />
    </g>
  )}
  {kind === 'patient' && (
    <g>
      <circle cx="22" cy="20" r="9" pathLength="1" class="ha-draw" style={d()} />
      <path d="M6 56 C7 42 13 34 22 34 C31 34 37 42 38 56" pathLength="1" class="ha-draw" style={d(0.2)} />
      <path d="M42 14 h16 a4 4 0 0 1 4 4 v14 a4 4 0 0 1 -4 4 h-12 l-4 4 v-4 a4 4 0 0 1 -4 -4 v-14 a4 4 0 0 1 4 -4 z" stroke-opacity="0.8" pathLength="1" class="ha-draw" style={d(0.5)} />
      {[0, 1, 2, 3, 4].map((i) => <path d={`M${45 + i * 3} ${25 - [3, 6, 4, 7, 3][i]} v${[6, 12, 8, 14, 6][i]}`} class:list={['ha-wave', { 'ha-acc': i === 2 || i === 3 }]} stroke-width="1.6" style={`${d(0.9)};--w:${0.45 + i * 0.1}s`} />)}
    </g>
  )}
  {kind === 'qa' && (
    <g>
      <path d="M6 10 h28 a4 4 0 0 1 4 4 v12 a4 4 0 0 1 -4 4 h-20 l-6 6 v-6 a4 4 0 0 1 -2 -4 v-12 a4 4 0 0 1 4 -4 z" pathLength="1" class="ha-draw" style={d()} />
      <text x="17" y="25" class="ha-cap ha-fade" style={`${d(0.4)};font-size:11px`}>?</text>
      <path d="M26 30 h28 a4 4 0 0 1 4 4 v12 a4 4 0 0 1 -4 4 h-2 v6 l-6 -6 h-20 a4 4 0 0 1 -4 -4 v-12 a4 4 0 0 1 4 -4 z" class="ha-acc" pathLength="1" style={d(0.5)} />
      <path d="M34 40 l4 4 l8 -8" class="ha-acc ha-draw" stroke-width="2" pathLength="1" style={d(1)} />
    </g>
  )}
  {kind === 'scale' && (
    <g>
      <path d="M32 12 V56 M20 56 H44" pathLength="1" class="ha-draw" style={d()} />
      <g class="ha-rock" style={`${d(0.6)};transform-box:view-box;transform-origin:32px 14px`}>
        <path d="M8 16 L56 12" />
        <path d="M8 16 L2 32 M8 16 L14 32 M0 32 H16 a8 4 0 0 1 -16 0 z" />
        <path d="M56 12 L50 28 M56 12 L62 28 M48 28 H64 a8 4 0 0 1 -16 0 z" class="ha-acc" />
      </g>
      <circle cx="32" cy="14" r="2.6" class="ha-acc-fill ha-pop" style={d(0.4)} />
    </g>
  )}
</svg>
