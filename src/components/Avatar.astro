---
// 成员头像：有照片用照片，没有则根据名字生成带网格纹理的首字母头像
interface Props {
  name: string;
  src?: string;
  seed: string;
}
const { name, src, seed } = Astro.props;
const initials = /[一-龥]/.test(name)
  ? name.slice(-2)
  : name.split(/\s+/).map((s) => s[0]).join('').slice(0, 2).toUpperCase();
let hash = 0;
for (const c of seed) hash = (hash * 31 + c.charCodeAt(0)) >>> 0;
const hue = [72, 160, 200, 18, 260][hash % 5];
const img = src && (src.startsWith('http') ? src : `${import.meta.env.BASE_URL.replace(/\/$/, '')}${src}`);
---

<div class="avatar" style={`--h:${hue}`}>
  {img ? (
    <img src={img} alt={name} loading="lazy" decoding="async" />
  ) : (
    <span class="avatar__initials" aria-hidden="true">{initials}</span>
  )}
</div>

<style>
  .avatar {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 16px 16px,
      radial-gradient(circle at 70% 20%, hsl(var(--h) 70% 55% / 0.55), transparent 60%),
      #15181d;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.6s;
  }
  :global(.person:hover) .avatar img { transform: scale(1.03); }
  .avatar__initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    letter-spacing: 0.02em;
  }
</style>
