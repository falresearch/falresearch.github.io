---
// 课题组标志：三支辉光管组成的 “FAL”（致敬世界线变动率探测仪）。
// 标志文件在 public/brand/：fal-logo.svg（完整标志）、fal-icon.svg（单支 F 管，用作浏览器小图标）
interface Props { size?: number }
const { size = 32 } = Astro.props;
const src = `${import.meta.env.BASE_URL}brand/fal-logo.svg`;
---

<img src={src} width={size} height={size} alt="" aria-hidden="true" class="logo" decoding="async" />

<style>
  .logo { display: block; flex: none; border-radius: 22%; }
</style>
