---
import { type Lang, loc, localizePath, stripLang, useT } from '../i18n';
import { site } from '../data/site';
import Logo from './Logo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const path = stripLang(Astro.url.pathname);

const nav = [
  { href: '/', label: t('nav.home') },
  { href: '/research', label: t('nav.research') },
  { href: '/publications', label: t('nav.publications') },
  { href: '/people', label: t('nav.people') },
  { href: '/contact', label: t('nav.contact') },
];
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="header dark">
  <div class="container header__inner">
    <a href={localizePath(lang, '/')} class="brand" aria-label={loc(site.name, lang)}>
      <Logo />
      <span class="brand__text">
        <span class="brand__short">{site.shortName}</span>
        <span class="brand__name">{loc(site.name, lang)}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {nav.map((item, i) => (
        <a href={localizePath(lang, item.href)} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
          <span class="nav__idx">0{i + 1}</span>{item.label}
        </a>
      ))}
    </nav>

    <div class="header__actions">
      <a href={localizePath(otherLang, path)} class="lang" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'} lang={otherLang === 'zh' ? 'zh-CN' : 'en'}>
        {t('lang.switch')}
      </a>
      <button class="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile">
    {nav.map((item, i) => (
      <a href={localizePath(lang, item.href)} class:list={['mobile-nav__link', { 'is-active': isActive(item.href) }]}>
        <span class="mono">0{i + 1}</span>{item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--ink-line);
    background: rgba(11, 13, 16, 0.86);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
  }
  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
  .brand__short { font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: 0.18em; }
  .brand__name { font-size: 12px; color: var(--ink-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .nav { display: flex; gap: 4px; margin-left: auto; }
  .nav__link {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 12px;
    font-size: 14px;
    color: var(--ink-muted);
    transition: color 0.2s;
  }
  .nav__idx { font-family: var(--font-mono); font-size: 10px; opacity: 0.6; }
  .nav__link:hover, .nav__link.is-active { color: var(--ink-text); }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 12px; right: 12px; bottom: -13px;
    height: 2px;
    background: var(--accent);
  }

  .header__actions { display: flex; align-items: center; gap: 8px; }
  .lang {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .lang:hover { background: var(--accent); border-color: var(--accent); color: var(--ink); }

  .menu-btn { display: none; width: 40px; height: 32px; position: relative; }
  .menu-btn span {
    position: absolute; left: 10px; right: 10px; height: 1.5px; background: var(--ink-text);
    transition: transform 0.25s, top 0.25s;
  }
  .menu-btn span:first-child { top: 12px; }
  .menu-btn span:last-child { top: 19px; }
  .header.is-open .menu-btn span:first-child { top: 15.5px; transform: rotate(45deg); }
  .header.is-open .menu-btn span:last-child { top: 15.5px; transform: rotate(-45deg); }

  .mobile-nav { display: none; }

  @media (max-width: 960px) {
    .nav { display: none; }
    .header__actions { margin-left: auto; }
    .menu-btn { display: block; }
    .mobile-nav {
      display: flex;
      flex-direction: column;
      max-height: 0;
      overflow: hidden;
      padding-inline: var(--gutter);
      transition: max-height 0.35s ease;
    }
    .header.is-open .mobile-nav { max-height: 420px; }
    .mobile-nav__link {
      display: flex; align-items: baseline; gap: 14px;
      padding: 14px 0;
      font-size: 20px;
      border-top: 1px solid var(--ink-line);
      color: var(--ink-muted);
    }
    .mobile-nav__link.is-active { color: var(--accent); }
    .mobile-nav__link:last-child { margin-bottom: 16px; }
  }
  @media (max-width: 420px) {
    .brand__name { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const btn = header?.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = header!.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
